name: Sync Red Hat CSAF VEX Data

on:
  schedule:
    # Runs at minute 0 past every hour
    - cron: '0 * * * *'
  workflow_dispatch:
    # Allows for manual triggering from the GitHub Actions UI

permissions:
  contents: write # Required to allow the bot to commit and push changes

jobs:
  sync-vex-data:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Fetch, Extract, and Download Missing Data
        run: |
          BASE_URL="https://security.access.redhat.com/data/csaf/v2/vex"
          
          # 1. Fetch the latest archive name (stripping any carriage returns)
          LATEST_ARCHIVE=$(curl -s "$BASE_URL/archive_latest.txt" | tr -d '\r')
          echo "Latest archive is: $LATEST_ARCHIVE"
          
          # 2. Download the archive file
          echo "Downloading $LATEST_ARCHIVE..."
          curl -O "$BASE_URL/$LATEST_ARCHIVE"
          
          # 3. Extract the archive
          # GitHub's ubuntu-latest runner includes zstd and tar by default
          echo "Extracting archive..."
          tar --zstd -xf "$LATEST_ARCHIVE"
          
          # Clean up the archive so we don't commit a massive binary to the repo
          rm "$LATEST_ARCHIVE"
          
          # 4. Download the index file containing the list of all expected files
          echo "Downloading index.txt..."
          curl -O "$BASE_URL/index.txt"
          
          # 5. Check and download missing files
          echo "Checking extracted files against index.txt..."
          
         

          # 1. Create a filtered list of only the files we care about (last 3 years)
          grep -E "$YEAR_PATTERN" index.txt | tr -d '\r' > filtered_index.txt
          
          # 2. Identify which of those files are NOT currently on disk
          # we use 'comm' to compare the filtered index with actual files in the folders
          ls -1 {$YEAR_0,$YEAR_1,$YEAR_2}/*.json 2>/dev/null | sort > files_on_disk.txt
          sort filtered_index.txt > sorted_index.txt
          comm -23 sorted_index.txt files_on_disk.txt > missing_files.txt
          
          # 3. Download missing files in parallel (e.g., 8 at a time)
          if [ -s missing_files.txt ]; then
              echo "Downloading $(wc -l < missing_files.txt) missing files in parallel..."
              # Create directories first
              cat missing_files.txt | xargs -I {} dirname {} | sort -u | xargs mkdir -p
              # Download
              cat missing_files.txt | xargs -n 1 -P 8 -I {} curl -s -f -o "{}" "$BASE_URL/{}"
          else
              echo "All files for the last 3 years are present."
          fi
          
          done < index.txt

      - name: Commit and Push to Repository
        run: |
          # Configure standard GitHub Actions bot credentials
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          
          # Add all changes (new files, modified files, deleted files)
          git add -A
          
          # Check if there are any changes staged. If yes, commit and push.
          if git diff --staged --quiet; then
            echo "No changes detected. Repository is up to date."
          else
            git commit -m "Automated hourly sync of Red Hat CSAF VEX data"
            git push
          fi
